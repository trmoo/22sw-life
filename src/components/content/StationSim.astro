---
// © 2026 티쳐무 · 모든 권리 보유 — 고등학교 「소프트웨어와 생활」 웹 교과서
/**
 * 대여소의 하루 — 첫 시뮬레이션 (Ⅳ-1·2·4)
 *
 * Ⅲ단원의 새솔시 이야기를 잇는다. 「아침 8시, 역 앞 대여소가 텅 비었다」를
 * 트럭을 실제로 보내 보기 전에 소프트웨어로 미리 실험한다.
 *
 * 화면 구역마다 시뮬레이션의 구성 요소 이름표를 붙였다 — 1차시가 가르치는 것이 화면에 그대로 보이게.
 *   변수(입력) 슬라이더 · 규칙 상자 · 상태(지금 자전거 수, 대여소 그림) · 출력(그래프·요약)
 * 4차시 「화면 구성 계획」에서 이 화면을 해부 예시로 다시 쓴다.
 *
 * 계산은 src/lib/simlab.js 의 대여소하루( )·대여소여러날( ). tools/check-simlab.mjs 가 성질을 시험한다.
 *
 * MDX 사용법
 *   <StationSim id="u4-l1-station" />
 *   <StationSim id="…" start={{ 처음: 25, 트럭: 10 }} />
 */
interface Props {
  id: string;
  start?: { 처음?: number; 트럭?: number; 세기?: number };
}
const { id, start = {} } = Astro.props;
const 처음 = { 처음: 10, 트럭: 0, 세기: 100, ...start };
---

<section class="lab sim" data-stationsim={id} data-start={JSON.stringify(처음)}>
  <header class="lab__head">
    <span class="lab__badge">시뮬레이터</span>
    <span class="lab__title">역 앞 대여소의 하루 — 새솔시 (지어낸 값)</span>
  </header>

  <div class="sim__grid">
    <div class="sim__box">
      <p class="sim__tag sim__tag--var">변수 · 입력</p>
      <label class="sim__slider">처음 자전거 <b data-out="처음"></b>대
        <input type="range" min="0" max="30" step="1" data-var="처음" /></label>
      <label class="sim__slider">아침 6시 30분 트럭 <b data-out="트럭"></b>대
        <input type="range" min="0" max="15" step="1" data-var="트럭" /></label>
      <label class="sim__slider">이용자 수 (평소의) <b data-out="세기"></b>%
        <input type="range" min="50" max="150" step="10" data-var="세기" /></label>
      <p class="sim__note">거치대는 30칸이다.</p>
    </div>
    <div class="sim__box">
      <p class="sim__tag sim__tag--rule">규칙</p>
      <ol class="sim__rules">
        <li>1분마다, 그 시간대의 이용자 수에 따른 확률로 <b>빌리러</b> 오는 사람이 있다. 자전거가 없으면 <b>헛걸음</b>.</li>
        <li>1분마다 같은 방식으로 <b>반납하러</b> 오는 사람이 있다. 거치대가 꽉 차면 <b>반납 실패</b>.</li>
        <li>6시 30분에 트럭이 자전거를 내려놓는다(30칸을 넘게는 못 놓는다).</li>
        <li>아침에는 빌리는 사람이, 저녁에는 반납하는 사람이 많다.</li>
      </ol>
    </div>
  </div>

  <div class="lab__row sim__run">
    <button type="button" class="lab__btn" data-act="day">▶ 하루 돌려 보기</button>
    <button type="button" class="lab__btn lab__btn--ghost" data-act="month">30일 돌려 보기</button>
    <span class="sim__seed" data-seed></span>
  </div>

  <div class="sim__grid">
    <div class="sim__box">
      <p class="sim__tag sim__tag--state">상태 · <span data-clock></span></p>
      <div class="sim__docks" data-docks aria-label="거치대 30칸"></div>
      <label class="sim__slider">시각 옮겨 보기
        <input type="range" min="0" max="16" step="1" value="0" data-time /></label>
    </div>
    <div class="sim__box">
      <p class="sim__tag sim__tag--out">출력</p>
      <div class="sim__stats" data-stats></div>
    </div>
  </div>
  <div class="lab__chart" data-chart></div>
  <div class="sim__month" data-month hidden></div>
</section>

<script>
  import { 난수, 대여소하루, 대여소여러날, 대여소기본 } from '@lib/simlab.js';
  import { 여러선 } from '@lib/datatools.js';

  for (const root of document.querySelectorAll<HTMLElement>('[data-stationsim]')) {
    const 처음값 = JSON.parse(root.dataset.start!);
    const $ = <T extends Element = HTMLElement>(s: string) => root.querySelector<T>(s)!;
    for (const k of ['처음', '트럭', '세기']) $<HTMLInputElement>(`[data-var="${k}"]`).value = String(처음값[k]);
    let 결과: ReturnType<typeof 대여소하루> | null = null;
    let 씨앗 = 0;

    const 변수 = () => ({
      처음: Number($<HTMLInputElement>('[data-var="처음"]').value),
      트럭: Number($<HTMLInputElement>('[data-var="트럭"]').value),
      세기: Number($<HTMLInputElement>('[data-var="세기"]').value) / 100,
      칸수: 30,
    });
    function 숫자표시() {
      const v = 변수();
      $('[data-out="처음"]').textContent = String(v.처음);
      $('[data-out="트럭"]').textContent = String(v.트럭);
      $('[data-out="세기"]').textContent = String(Math.round(v.세기 * 100));
    }

    function 거치대(시칸: number) {
      const 수 = 결과 ? 결과.기록[시칸].자전거 : 변수().처음;
      $('[data-clock]').textContent = `${대여소기본.시작시 + 시칸}시 · 자전거 ${수}대`;
      $('[data-docks]').innerHTML = Array.from({ length: 30 }, (_, i) => `<span class="${i < 수 ? 'on' : ''}"></span>`).join('');
    }

    function 하루() {
      씨앗 = Math.floor(Math.random() * 1e9);
      결과 = 대여소하루(변수(), 난수(씨앗));
      $('[data-seed]').textContent = `이번 하루의 씨앗 ${씨앗} — 누를 때마다 다른 하루가 나온다`;
      $('[data-stats]').innerHTML =
        `<div class="lab__stat"><span>헛걸음한 사람</span><b class="${결과.헛걸음 ? 'bad' : 'ok'}">${결과.헛걸음}명</b></div>` +
        `<div class="lab__stat"><span>반납 못 한 사람</span><b class="${결과.반납실패 ? 'bad' : 'ok'}">${결과.반납실패}명</b></div>` +
        `<div class="lab__stat"><span>텅 빈 시간</span><b>${결과.빈시간}분</b></div>` +
        `<div class="lab__stat"><span>빌려 간 자전거</span><b>${결과.빌림}대</b></div>`;
      const 시각 = 결과.기록.map((x) => `${x.시각}시`);
      $('[data-chart]').innerHTML = 여러선(
        [
          { 이름: '자전거 수', 값들: 결과.기록.map((x) => x.자전거), 색: '#b4492b' },
          { 이름: '거치대 30칸', 값들: 결과.기록.map(() => 30), 색: '#94a3b8', 점선: true },
        ],
        { x값들: 시각, x이름: '시각', y이름: '자전거 수(대)', y최대: 30, 눈금수: 8 }
      );
      $<HTMLInputElement>('[data-time]').value = '0';
      거치대(0);
    }

    function 한달() {
      const 결과들 = [];
      const 시작 = Math.floor(Math.random() * 1e9);
      for (let i = 0; i < 30; i++) 결과들.push(대여소하루(변수(), 난수(시작 + i)));
      const 나쁜 = 결과들.filter((r) => r.헛걸음 > 0).length;
      const 넘친 = 결과들.filter((r) => r.반납실패 > 0).length;
      const 긴 = 대여소여러날(변수(), 1000, 난수(시작));
      const el = $('[data-month]');
      el.hidden = false;
      el.innerHTML =
        `<p><b>30일</b> 가운데 헛걸음한 사람이 있었던 날 <b class="bad">${나쁜}일</b> · 저녁에 반납 못 한 사람이 있었던 날 <b>${넘친}일</b></p>` +
        `<div class="sim__days">${결과들.map((r, i) => `<span class="${r.헛걸음 ? 'bad' : 'ok'}" title="${i + 1}일 헛걸음 ${r.헛걸음}명">${i + 1}</span>`).join('')}</div>` +
        `<p class="sim__note">같은 조건으로 1,000일을 돌리면 헛걸음이 있었던 날은 <b>${Math.round(긴.비율 * 100)}%</b> 다. 30일만 돌리면 이 값에서 조금씩 흔들린다 — 여러 번 돌려 보는 까닭이다.</p>`;
    }

    root.addEventListener('input', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.matches('[data-time]')) return 거치대(Number(t.value));
      숫자표시();
      if (!결과) 거치대(0);
    });
    root.addEventListener('change', (e) => {
      if ((e.target as HTMLElement).matches('[data-var]')) $('[data-month]').hidden = true;
    });
    root.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-act]');
      if (!b) return;
      if (b.dataset.act === 'day') 하루();
      if (b.dataset.act === 'month') { if (!결과) 하루(); 한달(); }
    });
    숫자표시();
    거치대(0);
    $('[data-chart]').innerHTML = '<p class="lab__empty">▶ 하루 돌려 보기를 누르면 자전거 수의 변화가 그려진다.</p>';
  }
</script>
