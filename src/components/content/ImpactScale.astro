---
/**
 * © 2026 티쳐무 · 모든 권리 보유
 * 영향 저울 — 한 사례의 긍정·부정 영향을 저울에 올려 무게를 따져 본다
 *
 * 영향 카드마다 「얼마나 큰가」(0~3)를 학생이 정한다. 저울이 기우는 쪽은
 * 정답이 아니라 «내 판단»이다. 같은 사례로도 사람마다 기울기가 달라지는 것을 보고,
 * 왜 그렇게 정했는지 근거를 말하게 하는 토의의 출발점으로 쓴다.
 * 학생이 영향 카드를 직접 더할 수 있다.
 *
 * MDX 사용법
 *   <ImpactScale subject="무인 주문기(키오스크)" items={[
 *     { 글: '줄 서는 시간이 준다', 쪽: '긍정', 누구: '손님' },
 *     { 글: '화면이 낯선 어르신은 주문이 어렵다', 쪽: '부정', 누구: '노인' },
 *   ]} />
 */
interface Item {
  글: string;
  쪽: '긍정' | '부정';
  누구?: string;
}
interface Props {
  subject: string;
  items: Item[];
}
const { subject, items } = Astro.props;
---

<div class="sc" data-scale>
  <div class="sc__head">
    <span class="sc__label">영향 저울</span>
    <span class="sc__title">{subject}</span>
  </div>
  <p class="sc__how">
    카드마다 영향이 <strong>얼마나 큰지</strong> 0~3 사이로 정해 보자. 저울은 내 판단을 따라 기운다.
  </p>

  <svg class="sc__svg" viewBox="0 0 400 175" role="img" aria-label="긍정과 부정의 무게를 비교하는 저울" data-svg>
    <polygon points="200,40 182,160 218,160" fill="#cbd5e1" />
    <rect x="150" y="158" width="100" height="8" rx="4" fill="#94a3b8" />
    <g data-beam style="transform-origin:200px 40px; transition: transform .4s ease">
      <rect x="50" y="36" width="300" height="8" rx="4" fill="#475569" />
      <!-- 접시는 줄째로 보 끝에 매달려 늘 아래를 향한다 (줄을 보에 두면 접시와 따로 놀아 기울기가 안 보인다) -->
      <g data-pan-l>
        <line x1="70" y1="40" x2="70" y2="86" stroke="#94a3b8" stroke-width="2" />
        <path d="M30,86 h80 a40,18 0 0 1 -80,0z" fill="#15803d" opacity=".85" />
        <text x="70" y="126" text-anchor="middle" font-size="14" font-weight="700" fill="#15803d">긍정 <tspan data-sum-l>0</tspan></text>
      </g>
      <g data-pan-r>
        <line x1="330" y1="40" x2="330" y2="86" stroke="#94a3b8" stroke-width="2" />
        <path d="M290,86 h80 a40,18 0 0 1 -80,0z" fill="#b91c1c" opacity=".85" />
        <text x="330" y="126" text-anchor="middle" font-size="14" font-weight="700" fill="#b91c1c">부정 <tspan data-sum-r>0</tspan></text>
      </g>
    </g>
  </svg>

  <div class="sc__cols">
    {
      (['긍정', '부정'] as const).map((쪽) => (
        <section class={`sc__col sc__col--${쪽 === '긍정' ? 'good' : 'bad'}`}>
          <h5>{쪽} 영향</h5>
          <ul data-list={쪽}>
            {items
              .filter((it) => it.쪽 === 쪽)
              .map((it) => (
                <li class="sc__item" data-item data-side={쪽}>
                  <span class="sc__text">
                    {it.글}
                    {it.누구 && <span class="sc__who">{it.누구}</span>}
                  </span>
                  <input type="range" min="0" max="3" value="1" step="1" aria-label={`${it.글} — 영향의 크기`} />
                  <output>1</output>
                </li>
              ))}
          </ul>
          <form class="sc__add" data-add={쪽}>
            <input type="text" placeholder={`${쪽} 영향을 더 적어 보자`} aria-label={`${쪽} 영향 더하기`} />
            <button type="submit">＋</button>
          </form>
        </section>
      ))
    }
  </div>
  <p class="sc__verdict" data-verdict aria-live="polite"></p>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-scale]')) {
    const 보 = root.querySelector<SVGGElement>('[data-beam]')!;
    const 왼판 = root.querySelector<SVGGElement>('[data-pan-l]')!;
    const 오판 = root.querySelector<SVGGElement>('[data-pan-r]')!;

    function 다시재기() {
      let 긍 = 0,
        부 = 0;
      for (const li of root.querySelectorAll<HTMLElement>('[data-item]')) {
        const v = Number(li.querySelector('input')!.value);
        li.querySelector('output')!.textContent = String(v);
        if (li.dataset.side === '긍정') 긍 += v;
        else 부 += v;
      }
      root.querySelector('[data-sum-l]')!.textContent = String(긍);
      root.querySelector('[data-sum-r]')!.textContent = String(부);
      /* 무거운 쪽이 내려간다. 기울기는 ±15도로 묶는다 */
      const 각 = Math.max(-15, Math.min(15, (부 - 긍) * 3));
      보.style.transform = `rotate(${각}deg)`;
      /* 접시는 늘 아래를 향하게 반대로 돌린다 */
      왼판.style.transform = `rotate(${-각}deg)`;
      왼판.style.transformOrigin = '70px 40px';
      오판.style.transform = `rotate(${-각}deg)`;
      오판.style.transformOrigin = '330px 40px';
      const 판정 =
        긍 === 부
          ? '저울이 수평이다. 그렇다면 무엇을 더 알아야 판단할 수 있을까?'
          : 긍 > 부
            ? `내 판단으로는 긍정 쪽(${긍} 대 ${부})이 무겁다. 부정 영향을 줄이려면 무엇이 필요할까?`
            : `내 판단으로는 부정 쪽(${부} 대 ${긍})이 무겁다. 그래도 이 소프트웨어가 널리 쓰이는 까닭은 무엇일까?`;
      root.querySelector('[data-verdict]')!.textContent = 판정;
    }

    root.addEventListener('input', (e) => {
      if ((e.target as HTMLElement).matches('input[type=range]')) 다시재기();
    });

    for (const f of root.querySelectorAll<HTMLFormElement>('[data-add]')) {
      f.addEventListener('submit', (e) => {
        e.preventDefault();
        const t = f.querySelector('input')!;
        const 글 = t.value.trim();
        if (!글) return;
        const 쪽 = f.dataset.add!;
        const li = document.createElement('li');
        li.className = 'sc__item is-mine';
        li.dataset.item = '';
        li.dataset.side = 쪽;
        const s = document.createElement('span');
        s.className = 'sc__text';
        s.textContent = 글;
        const r = document.createElement('input');
        Object.assign(r, { type: 'range', min: '0', max: '3', value: '2', step: '1' });
        r.setAttribute('aria-label', `${글} — 영향의 크기`);
        const o = document.createElement('output');
        li.append(s, r, o);
        root.querySelector(`[data-list="${쪽}"]`)!.appendChild(li);
        t.value = '';
        다시재기();
      });
    }
    다시재기();
  }
</script>

<style>
  .sc {
    margin: var(--space-6) 0;
    padding: var(--space-4) var(--space-5);
    border: 1.5px solid var(--c-border-strong);
    border-radius: var(--radius);
    background: var(--c-surface);
  }
  .sc__head {
    display: flex;
    gap: var(--space-3);
    align-items: center;
  }
  .sc__label {
    font-size: 0.74rem;
    font-weight: 800;
    color: #fff;
    background: var(--c-accent);
    border-radius: var(--radius-pill);
    padding: 3px 10px;
  }
  .sc__title {
    font-weight: 800;
    font-size: 1.05rem;
  }
  .sc__how {
    color: var(--c-text-soft);
    font-size: 0.92rem;
  }
  .sc__svg {
    display: block;
    width: 100%;
    max-width: 420px;
    margin: 0 auto var(--space-3);
  }
  .sc__cols {
    display: grid;
    /* minmax(0,…) — 긴 글이 칸을 밀어 화면 밖으로 넘치지 않게 */
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-4);
  }
  @media (max-width: 640px) {
    .sc__cols {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .sc__col {
    border-radius: var(--radius-sm);
    padding: var(--space-3);
  }
  .sc__col h5 {
    margin: 0 0 var(--space-2);
    font-size: 1rem;
  }
  .sc__col--good {
    background: var(--ok-soft);
  }
  .sc__col--good h5 {
    color: var(--ok);
  }
  .sc__col--bad {
    background: var(--bad-soft);
  }
  .sc__col--bad h5 {
    color: var(--bad);
  }
  .sc__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .sc__col :global(input[type='range']) {
    width: 100%;
    min-width: 0;
  }
  .sc__col :global(.sc__item) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 76px 18px;
    gap: var(--space-2);
    align-items: center;
    padding: 8px 10px;
    margin: 0 0 6px;
    background: var(--c-surface);
    border-radius: var(--radius-sm);
    font-size: 0.93rem;
  }
  .sc__col :global(.sc__item.is-mine) {
    outline: 2px dashed var(--c-border-strong);
  }
  .sc__col :global(output) {
    font-family: var(--font-mono);
    font-weight: 800;
    text-align: right;
  }
  .sc__who {
    margin-left: 6px;
    font-size: 0.76rem;
    color: var(--c-text-faint);
    border: 1px solid var(--c-border);
    padding: 0 7px;
    border-radius: var(--radius-pill);
  }
  .sc__add {
    display: flex;
    gap: 6px;
    margin-top: var(--space-2);
  }
  .sc__add input {
    flex: 1;
    font: inherit;
    padding: 7px 10px;
    border: 1.5px solid var(--c-border-strong);
    border-radius: var(--radius-sm);
  }
  .sc__add button {
    font: inherit;
    font-weight: 800;
    width: 40px;
    border-radius: var(--radius-sm);
    border: 0;
    background: var(--c-text-soft);
    color: #fff;
    cursor: pointer;
  }
  .sc__verdict {
    margin: var(--space-4) 0 0;
    padding: var(--space-3) var(--space-4);
    background: var(--c-surface-2);
    border-radius: var(--radius-sm);
    font-weight: 600;
  }
</style>
