---
// © 2026 티쳐무 · 모든 권리 보유 — 고등학교 「소프트웨어와 생활」 웹 교과서
/**
 * 비식별화 실험실 — 공개하기 전에 «누구인지 드러나지 않게» 처리해 본다 ([12소생03-04])
 *
 * 고시문 고려 사항 「개인 정보가 포함된 데이터의 경우 개인 정보가 식별되지 않도록 처리」를
 * 직접 해 본다. 열마다 그대로 · 지우기 · 가리기 · 묶기 를 고르면,
 * 남은 정보가 똑같은 사람끼리 무리를 짓고 «혼자인 사람»(드러날 수 있는 사람)을 빨갛게 보여 준다.
 * 이름만 지워서는 안 된다는 것, 그리고 너무 많이 지우면 분석할 것이 남지 않는다는 것을
 * 함께 겪게 하는 것이 목적이다 (보호 ↔ 쓸모).
 *
 * 무리 셈은 src/lib/datatools.js 의 비식별처리( ) — k-익명성의 가장 쉬운 꼴이다.
 *
 * MDX 사용법
 *   <DeidLab id="u3-l8-deid" />     (기본 파일 people.csv, 가상 인물 12명)
 */
import { readFileSync } from 'node:fs';

interface Props {
  id: string;
  file?: string;
  /** 분석 목적에 꼭 남아 있어야 하는 열 (지우면 목표 실패) */
  need?: string[];
  purpose?: string;
}
const {
  id,
  file = 'people.csv',
  need = ['나이', '자주쓰는대여소'],
  purpose = '새솔시가 «나이대에 따라 어느 대여소를 많이 쓰는지» 분석하려고, 이용자 설문 결과를 누구나 내려받게 공개하려 한다.',
} = Astro.props;
const csv = readFileSync(`public/data/${file}`, 'utf8');
---

<section class="lab" data-deidlab={id} data-need={need.join(',')}>
  <script type="application/json" data-csv set:html={JSON.stringify(csv)} />
  <header class="lab__head">
    <span class="lab__badge">비식별화 실험실</span>
    <span class="lab__title">{file} — 가상 인물 설문</span>
    <button type="button" class="lab__btn lab__btn--ghost" data-reset>처음으로</button>
  </header>
  <p class="lab__purpose"><b>상황</b> {purpose}</p>

  <div class="lab__deid-cols" data-cols></div>

  <ul class="lab__goals" data-goals aria-live="polite"></ul>

  <div class="lab__legend">
    <span class="lab__lg lab__lg--out">혼자 — 남은 정보만으로 누구인지 짐작할 수 있다</span>
  </div>
  <div class="lab__table" data-table></div>
</section>

<script>
  import { CSV읽기, 비식별처리, 묶는법 } from '@lib/datatools.js';

  /* 묶기를 하면 어떻게 바뀌는지 — 단추 옆에 보여 준다 */
  const 묶기설명: Record<string, string> = {
    나이: '17 → 10대', 전화: '모두 가림', 학교: '→ 고등학교', 자주쓰는대여소: '→ 시내·동네', 동네: '→ 새솔시', 이름: '→ 성만',
  };
  const 직접식별자 = ['이름', '전화'];

  for (const root of document.querySelectorAll<HTMLElement>('[data-deidlab]')) {
    const 표 = CSV읽기(JSON.parse(root.querySelector('[data-csv]')!.textContent!));
    const 필요 = (root.dataset.need ?? '').split(',').filter(Boolean);
    const $ = <T extends Element = HTMLElement>(s: string) => root.querySelector<T>(s)!;
    let 방법: Record<string, string> = {};

    function 처음() {
      방법 = Object.fromEntries(표.열.map((k) => [k, '그대로']));
      칸그리기();
      그리기();
    }

    function 칸그리기() {
      $('[data-cols]').innerHTML = 표.열
        .map((k) => {
          const 고를것 = ['그대로', '지우기', '가리기', ...(k in 묶는법 && !['성별', '이름', '전화'].includes(k) ? ['묶기'] : [])];
          return (
            `<div class="lab__deid-col"><b>${k}</b><div class="lab__seg" role="radiogroup" aria-label="${k} 처리">` +
            고를것.map((m) => `<button type="button" data-col="${k}" data-how="${m}" aria-pressed="${방법[k] === m}" title="${m === '묶기' ? 묶기설명[k] ?? '' : ''}">${m}</button>`).join('') +
            `</div></div>`
          );
        })
        .join('');
    }

    function 그리기() {
      const r = 비식별처리(표.행, 방법);
      const 혼자 = r.무리.filter((n: number) => n === 1).length;
      const k최소 = Math.min(...r.무리);
      const 식별자남음 = 직접식별자.filter((c) => 방법[c] === '그대로');
      const 필요빠짐 = 필요.filter((c) => 방법[c] === '지우기' || 방법[c] === '가리기');
      const 목표 = [
        { 됨: !식별자남음.length, 글: 식별자남음.length ? `「${식별자남음.join('」·「')}」 처럼 그 사람을 바로 가리키는 정보가 그대로다` : '이름·전화처럼 사람을 바로 가리키는 정보가 없다' },
        { 됨: 혼자 === 0, 글: 혼자 ? `혼자인 사람이 ${혼자}명 — 남은 정보만 겹쳐 봐도 누구인지 드러날 수 있다` : `모든 사람이 ${k최소}명 이상의 무리 속에 숨었다` },
        { 됨: !필요빠짐.length, 글: 필요빠짐.length ? `「${필요빠짐.join('」·「')}」 를 없애면 분석 목적을 이룰 수 없다` : `분석에 필요한 「${필요.join('」·「')}」 정보가 남아 있다` },
      ];
      const 다 = 목표.every((g) => g.됨);
      $('[data-goals]').innerHTML =
        목표.map((g) => `<li class="${g.됨 ? 'is-ok' : 'is-bad'}">${g.됨 ? '✓' : '✗'} ${g.글}</li>`).join('') +
        (다 ? `<li class="is-done">공개해도 될 만큼 처리했다. 그런데 무엇을 잃었는지도 적어 두자 — 묶을수록 분석은 거칠어진다.</li>` : '');

      const 머리 = `<tr>${r.남은열.map((c: string) => `<th>${c}</th>`).join('')}<th>같은 모습</th></tr>`;
      const 몸 = r.행
        .map((row: Record<string, string>, i: number) => {
          const n = r.무리[i];
          return `<tr class="${n === 1 ? 'r-alone' : ''}">${r.남은열.map((c: string) => `<td>${row[c]}</td>`).join('')}<td class="c-k">${n === 1 ? '혼자' : `${n}명`}</td></tr>`;
        })
        .join('');
      $('[data-table]').innerHTML = r.남은열.length
        ? `<table>${머리}${몸}</table>`
        : '<p class="lab__empty">모든 열을 지웠다. 이제 아무도 드러나지 않지만, 분석할 것도 남지 않았다.</p>';
    }

    root.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('[data-reset]')) return 처음();
      const b = t.closest<HTMLElement>('[data-how]');
      if (!b) return;
      방법[b.dataset.col!] = b.dataset.how!;
      칸그리기();
      그리기();
    });
    처음();
  }
</script>
