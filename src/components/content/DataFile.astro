---
// © 2026 티쳐무 · 모든 권리 보유 — 고등학교 「소프트웨어와 생활」 웹 교과서
/**
 * 연습용 데이터 파일 카드 — 무엇이 들었는지 보여 주고 내려받게 한다
 *
 * 본문에서 데이터 파일 주소를 직접 적으면 GitHub Pages 하위 경로에서 깨진다
 * (LessonLink 와 같은 까닭). 그래서 주소는 이 컴포넌트가 base 를 붙여 만든다.
 * 줄 수·열 이름은 빌드할 때 파일을 직접 읽어 센다 — 본문에 손으로 적으면 데이터를 다시 만들 때 어긋난다.
 *
 * MDX 사용법
 *   <DataFile name="bike.csv" desc="새솔시 공유 자전거 일별 기록" />
 */
import { readFileSync, statSync } from 'node:fs';

interface Props {
  name: string;
  desc: string;
}
const { name, desc } = Astro.props;
const 경로 = `public/data/${name}`;
const 글 = readFileSync(경로, 'utf8').replace(/^﻿/, '');
const 크기 = statSync(경로).size;
const csv인가 = name.endsWith('.csv');
const 줄 = 글.split(/\r?\n/).filter((l) => l !== '');
const 열 = csv인가 ? 줄[0].split(',') : [];
const 행수 = csv인가 ? 줄.length - 1 : 줄.length;
const BASE = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---

<div class="datafile">
  <div class="datafile__icon" aria-hidden="true">{csv인가 ? '▦' : '¶'}</div>
  <div class="datafile__body">
    <p class="datafile__name"><code>{name}</code> <span>{desc}</span></p>
    <p class="datafile__meta">
      {csv인가 ? `${행수}줄 · ${열.length}열` : `글 ${행수}줄`} · {(크기 / 1024).toFixed(1)}KB
      {csv인가 && <> · 열: {열.join(', ')}</>}
    </p>
  </div>
  <a class="datafile__get" href={`${BASE}data/${name}`} download={name}>⬇ 내려받기</a>
</div>

<style>
  .datafile {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: var(--space-4) 0;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    background: var(--c-surface);
    min-width: 0;
  }
  .datafile__icon {
    flex: none;
    width: 2.4em;
    height: 2.4em;
    display: grid;
    place-items: center;
    font-size: 1.2rem;
    border-radius: var(--radius-sm);
    background: var(--c-primary-soft);
    color: var(--c-primary-deep);
  }
  .datafile__body {
    min-width: 0;
    flex: 1;
  }
  .datafile__name,
  .datafile__meta {
    margin: 0;
  }
  .datafile__name span {
    font-weight: 700;
    margin-left: 6px;
  }
  .datafile__meta {
    font-size: 0.84rem;
    color: var(--c-text-soft);
    overflow-wrap: anywhere;
  }
  .datafile__get {
    flex: none;
    font-weight: 700;
    font-size: 0.9rem;
    padding: 7px 12px;
    border: 1px solid var(--c-primary);
    border-radius: var(--radius-sm);
    color: var(--c-primary);
    text-decoration: none;
  }
  .datafile__get:hover {
    background: var(--c-primary-soft);
  }
  @media (max-width: 520px) {
    .datafile {
      flex-wrap: wrap;
    }
  }
</style>
